{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Mzizi",
  "colors": {
    "primary": "#4A616B",
    "light": "#C9D2D7",
    "dark": "#4A616B"
  },
  "background": {
    "color": {
      "light": "#F3F3F1",
      "dark": "#0E0D0C"
    }
  },
  "fonts": {
    "heading": {
      "family": "Noto Serif",
      "weight": 600
    },
    "body": {
      "family": "Noto Sans",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/images/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Language",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "status",
              "tracker",
              "pilots",
              "roadmap",
              "ecosystem"
            ]
          },
          {
            "group": "The language",
            "pages": ["syntax", "primitives", "ir"]
          },
          {
            "group": "The research programme",
            "pages": ["charter", "benchmark", "rfcs"]
          }
        ]
      },
      {
        "tab": "Toolchain",
        "groups": [
          {
            "group": "Toolchain",
            "pages": [
              "toolchain/overview",
              "compiler",
              "toolchain/mcp",
              "toolchain/cli",
              "toolchain/skills"
            ]
          }
        ]
      },
      {
        "tab": "Components",
        "groups": [
          {
            "group": "Mzizi Roots",
            "pages": ["roots/overview"]
          },
          {
            "group": "The registry",
            "pages": [
              "registry/overview",
              "registry/consuming",
              "registry/contributing",
              "registry/schema",
              "registry/components"
            ]
          },
          {
            "group": "Registry architecture",
            "pages": [
              "architecture/overview",
              "architecture/nodes",
              "architecture/backlinks"
            ]
          },
          {
            "group": "Foundations",
            "pages": [
              "foundations/overview",
              "foundations/tokens",
              "foundations/typography",
              "foundations/layout",
              "foundations/motion",
              "foundations/icons",
              "foundations/accessibility",
              "foundations/internationalization"
            ]
          },
          {
            "group": "Patterns",
            "pages": [
              "patterns/overview",
              "patterns/architecture",
              "patterns/components",
              "patterns/error-boundaries",
              "patterns/observability",
              "patterns/lazy-loading",
              "patterns/mobile-first",
              "patterns/dashboard",
              "patterns/dashboard-standard",
              "patterns/authentication",
              "patterns/resource-index",
              "patterns/resource-detail"
            ]
          },
          {
            "group": "Blocks",
            "pages": [
              "blocks/overview",
              "blocks/dashboard",
              "blocks/authentication",
              "blocks/sidebar"
            ]
          },
          {
            "group": "Charts",
            "pages": [
              "charts/overview",
              "charts/area",
              "charts/bar",
              "charts/line",
              "charts/pie",
              "charts/radar",
              "charts/radial",
              "charts/tooltip"
            ]
          },
          {
            "group": "Content style",
            "pages": [
              "content/overview",
              "content/writing",
              "content/error-messages",
              "content/inclusive-language"
            ]
          }
        ]
      },
      {
        "tab": "Platform",
        "groups": [
          {
            "group": "Platform",
            "pages": ["platform/api-gateway", "platform/data", "console"]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/tooling",
      "destination": "/toolchain/overview"
    },
    {
      "source": "/registry/mcp",
      "destination": "/toolchain/mcp"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/mzizi-dev/mzizi"
      }
    ],
    "primary": {
      "type": "button",
      "label": "mzizi.dev",
      "href": "https://mzizi.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/mzizi-dev"
    },
    "links": [
      {
        "header": "Contact",
        "items": [
          {
            "label": "support@bundu.org",
            "href": "mailto:support@bundu.org"
          },
          {
            "label": "Security: security@nyuchi.com",
            "href": "mailto:security@nyuchi.com"
          }
        ]
      }
    ]
  },
  "description": "Mzizi is a research language and compiler in Rust whose syntax, type system and compiler feedback loop are designed for machine authorship by small open-weight models. Phase 0 is a prototype front end; two small pilots have run and neither showed an advantage."
}
